# =============================================================================
# .gitignore — Ballon d'Or Prediction Engine
# =============================================================================
# Strategy:
#   - EXCLUDE large reproducible caches (Wikipedia HTML/JSON pages,
#     ~175 MB total). These are regenerated by the scrapers on demand.
#   - KEEP all code, configs, processed data, reports, and audit logs.
#   - EXCLUDE any credentials, environment files, Python caches.
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Secrets / credentials ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials/

# --- OS ---
Thumbs.db
desktop.ini

# =============================================================================
# Project-specific exclusions
# =============================================================================

# --- Cached Wikipedia HTML/JSON pages (reproducible via scrapers) ---
# These total ~175 MB and are regenerated by running the scrapers.
# We keep the parsed/aggregated JSONL outputs (nominees_raw.jsonl, etc.)
# but exclude the raw page caches.
data/raw/ground_truth/pages_api/
data/raw/ground_truth/pages/
data/raw/stats/pages_api/
data/raw/_phase1_*.html
data/raw/**/_*.html

# --- Failed-lookup logs (transient, regenerated on each scrape run) ---
data/raw/stats/_failed_lookups.txt
data/raw/stats/_fetch_log.txt

# --- Temporary / atomic-write files ---
*.tmp
*.jsonl.tmp

# --- Large intermediate outputs (regenerated by feature pipeline) ---
# Keep these local for development but don't commit bloat
data/interim/cache/

# --- Model artifacts (large; tracked separately if needed) ---
# models/checkpoints/
# models/*.pkl
# models/*.joblib

# --- Reports temp files ---
reports/_*.md
reports/_*.json
